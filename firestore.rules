rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Espace perso : seulement son propriétaire
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Index numéro → comptes : serveur uniquement
    match /numeros/{num} {
      allow read, write: if false;
    }

    // ── Foyers (espaces partagés)
    function connecte() { return request.auth != null; }
    function roleDans(fid) {
      return get(/databases/$(database)/documents/foyers/$(fid)).data.roles.get(request.auth.uid, '');
    }
    function lit(fid)   { return connecte() && roleDans(fid) in ['resp', 'membre', 'lect']; }
    function ecrit(fid) { return connecte() && roleDans(fid) in ['resp', 'membre']; }
    function resp(fid)  { return connecte() && roleDans(fid) == 'resp'; }

    // Codes d'invitation : lisibles si on connaît le code, jamais listés
    match /codes/{code} {
      allow get: if connecte();
      allow create: if connecte() && resp(request.resource.data.fid);
      allow delete: if connecte() && resp(resource.data.fid);
    }

    match /foyers/{fid} {
      allow read: if connecte() && resource.data.roles.get(request.auth.uid, '') != '';
      // Création : le créateur seul, comme responsable
      allow create: if connecte()
        && request.resource.data.roles.keys().hasOnly([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == 'resp';
      // Responsable : tout, à condition qu'il reste au moins un responsable
      allow update: if connecte()
        && resource.data.roles.get(request.auth.uid, '') == 'resp'
        && request.resource.data.roles.values().hasAny(['resp']);
      // Membre ou lecteur : uniquement se retirer lui-même
      allow update: if connecte()
        && resource.data.roles.get(request.auth.uid, '') in ['membre', 'lect']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'membres'])
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.roles)
        && request.resource.data.membres.diff(resource.data.membres).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if connecte() && resource.data.roles.get(request.auth.uid, '') == 'resp';

      // Demandes pour rejoindre : on ne peut que se proposer soi-même ; un responsable décide
      match /demandes/{duid} {
        allow create, update: if connecte() && request.auth.uid == duid
          && request.resource.data.statut == 'attente'
          && request.resource.data.keys().hasOnly(['nom', 'ident', 'foyer', 'date', 'statut']);
        allow read: if connecte() && (request.auth.uid == duid || resp(fid));
        allow update, delete: if resp(fid);
      }

      // Transactions : un membre crée en son nom et ne modifie que les siennes
      match /transactions/{tid} {
        allow read: if lit(fid);
        allow create: if resp(fid) || (ecrit(fid) && request.resource.data.createdById == request.auth.uid);
        allow update: if resp(fid) || (ecrit(fid)
          && resource.data.createdById == request.auth.uid
          && request.resource.data.createdById == request.auth.uid);
        allow delete: if resp(fid) || (ecrit(fid) && resource.data.createdById == request.auth.uid);
      }

      // Mouvements : un membre fait des virements, remboursements et retraits d'objectif en son nom ;
      // corrections de solde et pointages : responsables seulement
      match /mouvements/{mid} {
        allow read: if lit(fid);
        allow write: if resp(fid);
        allow create: if ecrit(fid)
          && request.resource.data.type in ['virement', 'remb', 'retrait_obj']
          && request.resource.data.createdById == request.auth.uid;
      }

      // Réglages : un membre peut tout sauf le budget, les modules et la liste des comptes
      match /data/{d} {
        allow read: if lit(fid);
        allow write: if resp(fid);
        allow update: if ecrit(fid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget', 'budgetDetails', 'modules', 'comptes']);
      }
    }
  }
}
